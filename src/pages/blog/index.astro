---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import BlogList from '../../components/blog/BlogList.astro';
import { getBlogs } from '../../lib/microcms';
import { transformBlogPost, calculateTotalPages } from '../../lib/utils/blog';
import { BLOG_CONFIG } from '../../lib/constants';
import StructuredData from '../../components/StructuredData.astro';

// microCMSから記事を取得（1ページ目）
const response = await getBlogs({ limit: BLOG_CONFIG.PAGINATION.POSTS_PER_PAGE });
const totalPages = calculateTotalPages(response.totalCount, BLOG_CONFIG.PAGINATION.POSTS_PER_PAGE);
const blogArticles = response.contents.map(transformBlogPost);
---

<Layout title="Blog - aiueueue's blog" description="Web開発とプログラミングに関する全ての記事">
  <StructuredData type="blog" />
  <Header currentPage="blog" />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <BlogList articles={blogArticles} currentPage={1} totalPages={totalPages} />
  </main>

  <Footer />
</Layout>
