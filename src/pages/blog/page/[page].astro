---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import ArticleCard from '../../../components/blog/ArticleCard.astro';
import Pagination from '../../../components/Pagination.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getBlogs, getBlogCount } from '../../../lib/microcms';
import { transformBlogPost, calculateTotalPages } from '../../../lib/utils/blog';
import { BLOG_CONFIG } from '../../../lib/constants';
import StructuredData from '../../../components/StructuredData.astro';

export async function getStaticPaths() {
  const totalCount = await getBlogCount();
  const totalPages = calculateTotalPages(totalCount, BLOG_CONFIG.PAGINATION.POSTS_PER_PAGE);

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: (i + 1).toString() },
    props: {
      page: i + 1,
      totalPages: totalPages
    }
  }));
}

const { page, totalPages } = Astro.props;

const perPage = BLOG_CONFIG.PAGINATION.POSTS_PER_PAGE;
const response = await getBlogs({
  limit: perPage,
  offset: (page - 1) * perPage,
});
const blogArticles = response.contents.map(transformBlogPost);
---

<Layout title={`Blog - ページ ${page}`} description="Web開発とプログラミングに関する記事一覧">
  <StructuredData type="blog" />
  <Header currentPage="blog" />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog', href: '/blog' },
        { label: `${page}ページ目` }
      ]}
    />

    <!-- Page Title -->
    <div class="mb-12 border-b border-gray-200 dark:border-gray-800 pb-4">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-retro-text">
        Blog
      </h1>
    </div>

    <!-- Blog Grid -->
    <div class="grid gap-6 md:gap-8 sm:grid-cols-2 lg:grid-cols-3 mb-12">
      {blogArticles.map((article, index) => (
        <div class="group h-full">
          <ArticleCard {...article} compact={false} eager={index < 3} fromPage={page} />
        </div>
      ))}
    </div>

    <!-- Pagination -->
    <Pagination
      currentPage={page}
      totalPages={totalPages}
      baseUrl="/blog"
    />
  </main>

  <Footer />
</Layout>
