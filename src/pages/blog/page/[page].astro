---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import BlogList from '../../../components/blog/BlogList.astro';
import { getBlogs, getBlogCount } from '../../../lib/microcms';
import { transformBlogPost, calculateTotalPages } from '../../../lib/utils/blog';
import { BLOG_CONFIG } from '../../../lib/constants';
import StructuredData from '../../../components/StructuredData.astro';

export async function getStaticPaths() {
  const totalCount = await getBlogCount();
  const totalPages = calculateTotalPages(totalCount, BLOG_CONFIG.PAGINATION.POSTS_PER_PAGE);

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: (i + 1).toString() },
    props: {
      page: i + 1,
      totalPages: totalPages
    }
  }));
}

const { page, totalPages } = Astro.props;

const perPage = BLOG_CONFIG.PAGINATION.POSTS_PER_PAGE;
const response = await getBlogs({
  limit: perPage,
  offset: (page - 1) * perPage,
});
const blogArticles = response.contents.map(transformBlogPost);
---

<Layout title={`Blog - ページ ${page}`} description="Web開発とプログラミングに関する記事一覧">
  <StructuredData type="blog" />
  <Header currentPage="blog" />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <BlogList articles={blogArticles} currentPage={page} totalPages={totalPages} />
  </main>

  <Footer />
</Layout>
